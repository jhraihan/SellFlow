# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# ---------------------------------------------------------------- required
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- database
# Leave unset to use SQLite. Set it to run against PostgreSQL locally,
# which is required for the concurrency tests in tests/test_concurrency.py
# because select_for_update takes no row lock on SQLite.
# Render sets this automatically in production.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/shopflow

# ---------------------------------------------------------------- frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com

# ---------------------------------------------------------------- encryption
# Encrypts courier API credentials at rest (PRD FR-2.5). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------- email
# Dev prints emails to the console; these are only needed in production.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@shopflow.app
